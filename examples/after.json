{
  "schema_version": 1,
  "metrics": {
    "net_revenue": {
      "grain": ["customer_id", "order_date"],
      "unit": "currency",
      "currency": "AUD",
      "aggregation": "sum",
      "expression": "gross_amount - refunded_amount",
      "filter": "status IN ('settled', 'pending')",
      "timezone": "Australia/Melbourne",
      "joins": {
        "customer": {
          "cardinality": "many_to_many",
          "condition": "orders.customer_id = customers.id"
        }
      }
    }
  }
}
